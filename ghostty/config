# --- Typography ---
font-family = "Google Sans Code"
font-family = "Maple Mono NF CN"
font-size = 13
font-style = "Medium"

# --- Theme and Colors ---
theme = dark:GitHub Dark Dimmed,light:GitHub Light Default
macos-icon = paper

# --- Window and Appearance ---
background-opacity = 0.95
background-blur-radius = 30
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
window-save-state = always
window-theme = auto
window-inherit-working-directory = true
unfocused-split-opacity = 0.85

# --- Cursor ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# --- Mouse ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
shell-integration = zsh
shell-integration-features = ssh-env,ssh-terminfo

# --- Other ---
quit-after-last-window-closed = true
notify-on-command-finish = unfocused
macos-option-as-alt = true

# --- Performance ---
scrollback-limit = 10485760

# --- Keyboard Scroll ---
keybind = cmd+k=scroll_page_lines:-5
keybind = cmd+j=scroll_page_lines:5

# --- Line Editing ---
# Cmd-Left/Right: line start/end (^A/^E); Option-Left/Right: word back/forward
keybind = cmd+arrow_left=text:\x01
keybind = cmd+arrow_right=text:\x05
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
